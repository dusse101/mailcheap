{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light\">\n<title>Hi &amp; there</title>\n<style>\n.body a { color: #18181b; }\n.body img { max-width: 100%; height: auto; border-radius: 8px; }\n.body h1, .body h2, .body h3 { line-height: 1.3; margin: 32px 0 12px; color: #09090b; }\n.body p, .body ul, .body ol { margin: 0 0 16px; }\n.body blockquote { margin: 0 0 16px; padding-left: 16px; border-left: 3px solid #e4e4e7; color: #52525b; }\n.body code { font-family: ui-monospace, Menlo, monospace; font-size: 14px; background: #f4f4f5; padding: 2px 4px; border-radius: 4px; }\n.body hr { border: 0; border-top: 1px solid #e4e4e7; margin: 32px 0; }\n</style>\n</head>\n<body style=\"margin:0;padding:0;background:#ffffff;\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;\" data-preheader>Preview&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;\">\n<tr><td align=\"center\" style=\"padding:32px 20px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.65;color:#27272a;\">\n<tr><td align=\"right\" style=\"padding:0 0 24px;font-size:12px;line-height:1;\"><a href=\"https://news.example.com/p/issue-1\" style=\"color:#a1a1aa;text-decoration:none;\">Read online</a></td></tr>\n<tr><td class=\"body\"><h1>Hello</h1>\n<p>A <a href=\"https://example.com\">link</a>.</p>\n<p><a href=\"{{confirm_url}}\" style=\"display:inline-block;background:#18181b;color:#ffffff;text-decoration:none;font-weight:600;padding:12px 22px;border-radius:8px;\">Confirm</a></p>\n</td></tr>\n<tr><td style=\"padding:32px 0 0;font-size:12px;line-height:1.6;color:#71717a;border-top:1px solid #e4e4e7;\">\nYou're receiving this because you subscribed to Field notes.<br>\n<a href=\"{{unsubscribe_url}}\" style=\"color:#71717a;text-decoration:underline;\">Unsubscribe</a><br>1 Main St, Paris\n</td></tr>\n</table>\n</td></tr>\n</table>\n</body>\n</html>","text":"Read online: https://news.example.com/p/issue-1\n\nHello\n\nA link (https://example.com).\n\nConfirm ({{confirm_url}})\n\n—\nYou're receiving this because you subscribed to Field notes.\nUnsubscribe: {{unsubscribe_url}}\n1 Main St, Paris"}